{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist-electron",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "electron/**/*",
    "src/domains/**/*",
    "src/application/**/*",
    "src/infrastructure/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "release",
    "**/__tests__/**"
  ]
}